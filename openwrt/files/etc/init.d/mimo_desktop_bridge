#!/bin/sh /etc/rc.common
# procd service for mimo_desktop_bridge headless server on OpenWrt.

START=95
STOP=10
USE_PROCD=1

PROG=/usr/bin/mimo_desktop_bridge
CONF=mimo_desktop_bridge

# Persist session/settings here (survives reboots; add to /etc/sysupgrade.conf).
DATA_DIR=/etc/mimo_desktop_bridge

start_service() {
	local enabled host port verbose tls tls_cert tls_key

	config_load "$CONF"
	config_get_bool enabled  main enabled 1
	config_get      host     main host    "0.0.0.0"
	config_get      port     main port    "8787"
	config_get_bool verbose  main verbose 0
	config_get_bool tls      main tls     0
	config_get      tls_cert main tls_cert ""
	config_get      tls_key  main tls_key  ""

	[ "$enabled" = "1" ] || {
		echo "mimo_desktop_bridge disabled in /etc/config/$CONF" >&2
		return 1
	}

	mkdir -p "$DATA_DIR"

	procd_open_instance
	procd_set_param command "$PROG" server \
		--host "$host" \
		--port "$port" \
		--config-dir "$DATA_DIR"

	[ "$tls" = "1" ] && procd_append_param command --tls
	[ -n "$tls_cert" ] && procd_append_param command --tls-cert "$tls_cert"
	[ -n "$tls_key" ] && procd_append_param command --tls-key "$tls_key"

	procd_set_param env \
		RUST_LOG="mimo_desktop_bridge_lib=$( [ "$verbose" = 1 ] && echo debug || echo info )"

	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger "$CONF"
}

reload_service() {
	stop
	start
}
